{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/config-schema.json",
  "entry": [
    "apps/api/src/main.ts",
    "apps/telegram-bot/src/index.ts",
    "packages/contracts/src/index.ts",
    "packages/contracts/src/v1/index.ts",
  ],
  "ignorePatterns": [
    "apps/**/dist/**",
    "packages/**/dist/**",
    "apps/api/src/generated/**",
    "docs/archive/**",
  ],
  "dynamicallyLoaded": ["apps/telegram-bot/src/features/**/*.command.ts"],
  "duplicates": {
    "ignore": [
      "apps/**/dist/**",
      "packages/**/dist/**",
      "apps/api/src/generated/**",
      "docs/archive/**",
    ],
    "ignoreImports": true,
  },
  "ignoreDependencies": ["@aion/contracts", "@nestjs/schematics"],
  "audit": {
    "gate": "new-only",
  },
}
