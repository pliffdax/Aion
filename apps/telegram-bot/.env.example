# Runtime: dev | test | prod. The dev:test script overrides this with test.
MODE=dev

# Telegram
BOT_TOKEN=
# Required by pnpm dev:telegram-bot:test. Use a separate bot created through BotFather.
BOT_TOKEN_TEST=
TELEGRAM_OWNER_ID=
# Optional comma-separated IDs; no trailing comma is required.
# TELEGRAM_OWNER_ID is always allowed and does not need to be repeated here.
TELEGRAM_ALLOWED_USER_IDS=
# Personal report counter. Week 1 / Day 1 starts on this date.
TELEGRAM_REPORT_START_DATE=2025-10-13
TELEGRAM_REPORT_AUTHOR_TAG="#АлександрСтепанов"

# Aion API
API_URL=http://localhost:3000/api/v1
API_URL_TEST=http://localhost:3001/api/v1
# Must exactly match API_KEY from apps/api/.env.
API_KEY=
