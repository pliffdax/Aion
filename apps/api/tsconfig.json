{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",

    "moduleResolution": "Node16",
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src", "test", "prisma.config.ts"]
}
