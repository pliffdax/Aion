{
  "name": "aion",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:api": "pnpm --filter @aion/api dev",
    "dev:api:test": "pnpm --filter @aion/api dev:test",
    "dev:telegram-bot": "pnpm --filter @aion/telegram-bot dev",
    "dev:telegram-bot:test": "pnpm --filter @aion/telegram-bot dev:test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @aion/api db:generate",
    "db:migrate:dev": "pnpm --filter @aion/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @aion/api db:migrate:deploy",
    "build": "pnpm -r build",
    "build:contracts": "pnpm --filter @aion/contracts build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm db:generate && pnpm build:contracts && pnpm -r typecheck",
    "quality": "pnpm lint && pnpm typecheck && pnpm build",
    "quality:dupes": "pnpm exec fallow dupes --mode semantic"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "fallow": "^2.88.3",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
